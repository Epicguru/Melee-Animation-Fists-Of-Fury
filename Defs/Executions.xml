<Defs>

<!-- Abstract base -->
  <AM.AnimDef Name="AnimExecFoF" ParentName="AnimExecutionBase" Abstract="True">
    <weaponFilter Class="AM.Reqs.MustBeFists"/>
    <animStartWorker>AM.FoF.FoFAnimStartWorker</animStartWorker>
    <handsVisibility>
      <li>
        <pawnIndex>0</pawnIndex>
        <showMainHand>true</showMainHand>
        <showAltHand>true</showAltHand>
      </li>
      <li>
        <pawnIndex>1</pawnIndex>
        <showMainHand>true</showMainHand>
        <showAltHand>true</showAltHand>
      </li>
    </handsVisibility>
  </AM.AnimDef>

  <!-- Executions -->
  <AM.AnimDef ParentName="AnimExecFoF">
    <defName>AM_FOF_Execution_JabCross</defName>
    <label>Execution: Jab Cross</label>
    <data>FOF_Execution_JabCross.json</data>
  </AM.AnimDef>

  <AM.AnimDef ParentName="AnimExecFoF">
    <defName>AM_FOF_Execution_Suplex</defName>
    <label>Execution: Suplex</label>
    <data>FOF_Execution_Suplex.json</data>
    <cellData>
      <li>
        <type>PawnEnd</type>
        <position>(-1, 0)</position>
        <pawnIndex>1</pawnIndex>
      </li>
    </cellData>
  </AM.AnimDef>

  <AM.AnimDef ParentName="AnimExecFoF">
    <defName>AM_FOF_Execution_Uppercut</defName>
    <label>Execution: Uppercut</label>
    <data>FOF_Execution_Uppercut.json</data>
  </AM.AnimDef>

    <AM.AnimDef ParentName="AnimExecFoF">
    <defName>AM_FOF_Execution_OverheadBash</defName>
    <label>Execution: Overhead Bash</label>
    <data>FOF_Execution_OverheadSmash.json</data>
  </AM.AnimDef>

  <AM.AnimDef ParentName="AnimExecFoF">
    <defName>AM_FOF_Execution_HeadTear</defName>
    <label>Execution: Head Tear</label>
    <data>FOF_Execution_HeadTear.json</data>
    <!-- Does not occur naturally, instead uses the promotion system. -->
    <relativeProbability>0</relativeProbability>
    <promotionRules>
      <onlyWhenOutcomeIs>Kill</onlyWhenOutcomeIs>
      <promotionWorkers>
        <li>AM.PromotionWorkers.MustHaveHeadPromotionWorker</li>
      </promotionWorkers>
    </promotionRules>
    <!-- Spawn head upon end. -->
    <spawnDroppedHeadsForPawnIndices>
      <li>1</li>
    </spawnDroppedHeadsForPawnIndices>
    <cellData>
      <li>
        <type>PawnEnd</type>
        <position>(1, 0)</position>
        <pawnIndex>1</pawnIndex>
      </li>
    </cellData>
  </AM.AnimDef>

</Defs>
